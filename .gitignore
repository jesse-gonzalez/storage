# MLPerf Storage Benchmark .gitignore
#
# This file excludes:
# - Generated benchmark data and results
# - Python/ML framework cache files
# - Development environment files
# - IDE and editor temporary files
# - OS-specific files
# - Docker build artifacts
#
# Keep this updated as new file types are generated during development

# Generated data directories
data/
results/

# MLPerf Storage specific
mlps_history
*.json.bak

# ML framework cache directories
.keras/
.tensorflow/
.torch/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.pyenv

# IDE and editors
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
.cache/

# Docker volumes and build cache
.docker/
docker-compose.override.yml
.dockerignore.local
.docker-build-*

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Shell history files
.bash_history
.zsh_history
.fish_history

# MPI and benchmark specific
*.out
*.err
core.*
slurm-*.out

# Archive files
*.tar.gz
*.zip
*.7z
*.rar

# Backup files
*.bak
*.backup
*~

# Test outputs
test_results/
benchmark_outputs/

# Local configuration
local_config.yaml
.local/

# Task runner temporary files
.task/

# JetBrains IDEs
.idea/
*.iml
*.iws
*.ipr

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# Coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# pyenv
.python-version

# conda
.conda/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json